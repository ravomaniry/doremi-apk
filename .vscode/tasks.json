{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install debug APK",
      "type": "shell",
      "command": "./gradlew",
      "args": ["installDebug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": ".\\gradlew.bat"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Doremi",
      "type": "shell",
      "command": "bash .vscode/start-doremi.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .vscode\\start-doremi.ps1"
      },
      "dependsOn": ["Install debug APK"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
