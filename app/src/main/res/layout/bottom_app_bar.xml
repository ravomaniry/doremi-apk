<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/tray_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tool_tray_background"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/spacing1"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/new_btn"
                style="@style/AppTheme.ToolAction"
                android:contentDescription="@string/action_new">

                <ImageView
                    style="@style/AppTheme.ToolIcon"
                    android:src="@drawable/ic_new" />

                <TextView
                    style="@style/AppTheme.ToolLabel"
                    android:text="@string/action_new" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/browse_btn"
                style="@style/AppTheme.ToolAction"
                android:contentDescription="@string/action_open">

                <ImageView
                    style="@style/AppTheme.ToolIcon"
                    android:src="@drawable/ic_open_solfa" />

                <TextView
                    style="@style/AppTheme.ToolLabel"
                    android:text="@string/action_open" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/save_btn"
                style="@style/AppTheme.ToolAction"
                android:contentDescription="@string/action_save">

                <ImageView
                    style="@style/AppTheme.ToolIcon"
                    android:src="@drawable/ic_save" />

                <TextView
                    style="@style/AppTheme.ToolLabel"
                    android:text="@string/action_save" />
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/tray_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tool_tray_background"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/spacing1">

                <LinearLayout
                    android:id="@+id/copy_btn"
                    style="@style/AppTheme.ToolAction"
                    android:contentDescription="@string/action_copy">

                    <ImageView
                        style="@style/AppTheme.ToolIcon"
                        android:src="@drawable/ic_content_copy" />

                    <TextView
                        style="@style/AppTheme.ToolLabel"
                        android:text="@string/action_copy" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/paste_btn"
                    style="@style/AppTheme.ToolAction"
                    android:contentDescription="@string/action_paste">

                    <ImageView
                        style="@style/AppTheme.ToolIcon"
                        android:src="@drawable/ic_content_paste" />

                    <TextView
                        style="@style/AppTheme.ToolLabel"
                        android:text="@string/action_paste" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/select_all_btn"
                    style="@style/AppTheme.ToolAction"
                    android:contentDescription="@string/action_select_all">

                    <ImageView
                        style="@style/AppTheme.ToolIcon"
                        android:src="@drawable/ic_select_all" />

                    <TextView
                        style="@style/AppTheme.ToolLabel"
                        android:text="@string/action_select_all" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/move_left_btn"
                    style="@style/AppTheme.ToolAction"
                    android:contentDescription="@string/action_move_left">

                    <ImageView
                        style="@style/AppTheme.ToolIcon"
                        android:src="@drawable/ic_arrow_left" />

                    <TextView
                        style="@style/AppTheme.ToolLabel"
                        android:text="@string/action_move_left" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/move_right_btn"
                    style="@style/AppTheme.ToolAction"
                    android:contentDescription="@string/action_move_right">

                    <ImageView
                        style="@style/AppTheme.ToolIcon"
                        android:src="@drawable/ic_arrow_right" />

                    <TextView
                        style="@style/AppTheme.ToolLabel"
                        android:text="@string/action_move_right" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/move_up_btn"
                    style="@style/AppTheme.ToolAction"
                    android:contentDescription="@string/action_move_up">

                    <ImageView
                        style="@style/AppTheme.ToolIcon"
                        android:src="@drawable/ic_arrow_up" />

                    <TextView
                        style="@style/AppTheme.ToolLabel"
                        android:text="@string/action_move_up" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/move_down_btn"
                    style="@style/AppTheme.ToolAction"
                    android:contentDescription="@string/action_move_down">

                    <ImageView
                        style="@style/AppTheme.ToolIcon"
                        android:src="@drawable/ic_arrow_down" />

                    <TextView
                        style="@style/AppTheme.ToolLabel"
                        android:text="@string/action_move_down" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/tray_export"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tool_tray_background"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/spacing1"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/print_btn"
                style="@style/AppTheme.ToolAction"
                android:contentDescription="@string/action_print">

                <ImageView
                    style="@style/AppTheme.ToolIcon"
                    android:src="@drawable/ic_print" />

                <TextView
                    style="@style/AppTheme.ToolLabel"
                    android:text="@string/action_print" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/save_mid_btn"
                style="@style/AppTheme.ToolAction"
                android:contentDescription="@string/action_midi">

                <ImageView
                    style="@style/AppTheme.ToolIcon"
                    android:src="@drawable/ic_save_mid" />

                <TextView
                    style="@style/AppTheme.ToolLabel"
                    android:text="@string/action_midi" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tray_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tool_tray_background"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/spacing1"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/help_btn"
                style="@style/AppTheme.ToolAction"
                android:contentDescription="@string/text_help">

                <ImageView
                    style="@style/AppTheme.ToolIcon"
                    android:src="@drawable/ic_help" />

                <TextView
                    style="@style/AppTheme.ToolLabel"
                    android:text="@string/text_help" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/about_btn"
                style="@style/AppTheme.ToolAction"
                android:contentDescription="@string/text_about">

                <ImageView
                    style="@style/AppTheme.ToolIcon"
                    android:src="@drawable/ic_about" />

                <TextView
                    style="@style/AppTheme.ToolLabel"
                    android:text="@string/text_about" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/tool_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing2"
        android:paddingTop="@dimen/spacing1">

        <LinearLayout
            android:id="@+id/group_file_btn"
            style="@style/AppTheme.ToolChip"
            android:contentDescription="@string/group_file">

            <ImageView
                style="@style/AppTheme.ToolIcon"
                android:src="@drawable/ic_folder_open_black_24dp" />

            <TextView
                style="@style/AppTheme.ToolLabel"
                android:text="@string/group_file" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/group_edit_btn"
            style="@style/AppTheme.ToolChip"
            android:contentDescription="@string/group_edit">

            <ImageView
                style="@style/AppTheme.ToolIcon"
                android:src="@drawable/ic_edit" />

            <TextView
                style="@style/AppTheme.ToolLabel"
                android:text="@string/group_edit" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/group_export_btn"
            style="@style/AppTheme.ToolChip"
            android:contentDescription="@string/group_export">

            <ImageView
                style="@style/AppTheme.ToolIcon"
                android:src="@drawable/ic_share" />

            <TextView
                style="@style/AppTheme.ToolLabel"
                android:text="@string/group_export" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/group_more_btn"
            style="@style/AppTheme.ToolChip"
            android:contentDescription="@string/group_more">

            <ImageView
                style="@style/AppTheme.ToolIcon"
                android:src="@drawable/ic_more" />

            <TextView
                style="@style/AppTheme.ToolLabel"
                android:text="@string/group_more" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/tool_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/spacing1"
        android:background="@color/gray" />

    <LinearLayout
        android:id="@+id/edit_transport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/spacing2"
        android:weightSum="55">

        <ImageButton
            android:id="@+id/menu_btn"
            style="@style/AppTheme.MenuIconButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="10"
            android:contentDescription="@string/help_open_menu"
            android:src="@drawable/ic_music_logo" />

        <ImageButton
            android:id="@+id/undo_btn"
            style="@style/AppTheme.MenuIconButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="10"
            android:contentDescription="@string/help_back"
            android:src="@drawable/ic_undo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="15"
            android:orientation="vertical"
            android:paddingHorizontal="5dp">

            <ImageButton
                android:id="@+id/play_btn"
                style="@style/AppTheme.PlayButton"
                android:contentDescription="@string/help_play"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/stop_btn"
                style="@style/AppTheme.StopButton"
                android:contentDescription="@string/hep_stop"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_stop_circle" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/redo_btn"
            style="@style/AppTheme.MenuIconButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="10"
            android:contentDescription="@string/help_back"
            android:src="@drawable/ic_redo" />

        <ImageButton
            android:id="@+id/preview_btn"
            style="@style/AppTheme.MenuIconButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="10"
            android:contentDescription="@string/help_show_keyboard"
            android:src="@drawable/ic_piano" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/play_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <mg.maniry.doremii.editor.views.PlaybackPianoView
            android:id="@+id/playback_piano"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/spacing2"
            android:weightSum="55">

            <ImageButton
                android:id="@+id/play_start_btn"
                style="@style/AppTheme.MenuIconButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="10"
                android:contentDescription="@string/play_beginning"
                android:src="@drawable/ic_to_start" />

            <ImageButton
                android:id="@+id/play_prev_btn"
                style="@style/AppTheme.MenuIconButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="10"
                android:contentDescription="@string/play_previous_measure"
                android:src="@drawable/ic_measure_previous" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="15"
                android:orientation="vertical"
                android:paddingHorizontal="5dp">

                <ImageButton
                    android:id="@+id/play_pause_btn"
                    style="@style/AppTheme.PlayButton"
                    android:contentDescription="@string/play_pause"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pause" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/play_next_btn"
                style="@style/AppTheme.MenuIconButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="10"
                android:contentDescription="@string/play_next_measure"
                android:src="@drawable/ic_measure_next" />

            <ImageButton
                android:id="@+id/play_close_btn"
                style="@style/AppTheme.MenuIconButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="10"
                android:contentDescription="@string/play_close"
                android:src="@drawable/ic_close" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
