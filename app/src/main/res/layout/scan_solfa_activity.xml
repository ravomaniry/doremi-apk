<?xml version="1.0" encoding="utf-8"?>
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scan_flipper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/scan_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/scan_still"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/scan_crop"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <mg.maniry.doremii.omr.CropOverlayView
            android:id="@+id/scan_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/scan_crop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/spacing4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scan_shutter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing2"
                android:text="@string/scan_shutter" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scan_gallery"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing2"
                android:text="@string/scan_gallery" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scan_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing2"
                android:text="@string/scan_read"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scan_retake"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_retake"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/scan_capture_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#CCFFFFFF"
            android:padding="@dimen/spacing3"
            android:textColor="@color/dark"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scan_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/spacing4"
        android:splitMotionEvents="false">

        <mg.maniry.doremii.omr.ZoomableImageView
            android:id="@+id/scan_review_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/scan_crop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing3"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/scan_signature"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Spinner
                android:id="@+id/scan_key"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/scan_review_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing2"
            android:textColor="@color/dark_gray" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scan_cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scan_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_confirm" />
        </LinearLayout>
    </LinearLayout>
</ViewFlipper>
