<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/screen_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/action_publish"
        app:titleTextColor="@color/colorPrimary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/login_mode_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/spacing4"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/text_name"
                app:boxBackgroundColor="@color/white"
                app:startIconDrawable="@drawable/ic_avatar">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/login_name_et"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing3"
                android:hint="@string/text_code"
                app:boxBackgroundColor="@color/white"
                app:startIconDrawable="@drawable/ic_password">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/login_code_et"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/login_submit_btn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing4"
                android:background="@drawable/rounded_button"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_done" />

            <Button
                android:id="@+id/login_cancel_btn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing3"
                android:text="@string/text_cancel"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/login_loader"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginTop="@dimen/spacing3"
                android:theme="@style/ThemeOverlay.Material3"
                android:visibility="gone" />

            <TextView
                android:id="@+id/login_error_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing3"
                android:gravity="center"
                android:text="@string/net_error"
                android:textColor="@color/colorAccentDark"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing4"
                android:drawablePadding="@dimen/spacing3"
                android:gravity="center"
                android:text="@string/login_tips"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/dark" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/upload_mode_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing4">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_cloud_upload" />

            <ProgressBar
                android:id="@+id/upload_loader_view"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing3"
                android:theme="@style/ThemeOverlay.Material3" />

            <TextView
                android:id="@+id/upload_filename_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing3"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

            <TextView
                android:id="@+id/upload_done_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing2"
                android:text="@string/text_upload_done"
                android:textColor="@color/colorPrimaryDark"
                android:visibility="gone" />

            <TextView
                android:id="@+id/upload_error_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing2"
                android:gravity="center"
                android:textColor="@color/colorAccentDark" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing4"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/upload_cancel_btn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing2"
                    android:text="@string/text_cancel" />

                <Button
                    android:id="@+id/upload_done_btn"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing2"
                    android:text="@string/text_done" />

                <Button
                    android:id="@+id/upload_retry_btn"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_retry" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
